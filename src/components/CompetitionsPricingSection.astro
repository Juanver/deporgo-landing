---
import { platformPricingPlans } from "@/data/competitions-platform-data";
---

<section
  id="precios-plataforma"
  class="py-20"
  aria-labelledby="pricing-title"
  data-reveal
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 id="pricing-title" class="mb-4 bg-linear-to-r from-primary-400 to-secondary-400 bg-clip-text text-4xl font-bold text-transparent md:text-5xl" data-reveal>
        Planes para cada etapa de tu competencia
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-secondary-300" data-reveal>
        Elige el plan que mejor se adapte a tu club, liga, torneo o campeonato.
        Todos incluyen acceso a las funciones clave de la plataforma.
      </p>
    </div>

    <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-3">
      {platformPricingPlans.map((plan) => (
        <article
          class={`relative rounded-2xl border transition-all duration-300 ${
            plan.highlighted
              ? "scale-105 border-primary-500 shadow-2xl"
              : "border-secondary-700"
          }`}
          style={plan.highlighted
            ? "background: linear-gradient(180deg, var(--primary-600-10) 0%, var(--secondary-600-20) 100%);"
            : "background-color: var(--secondary-800-50);"}
          aria-label={`Plan ${plan.name}`}
        >
          {plan.highlighted && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-primary-500 px-4 py-1 text-sm font-bold text-white">
              MÁS POPULAR
            </div>
          )}

          <div class="p-8">
            <h3 class="mb-2 text-2xl font-bold text-secondary-100">
              {plan.name}
            </h3>
            <p class="mb-4 text-sm text-secondary-400">
              {plan.description}
            </p>

            <div class="mb-6">
              <span class="text-4xl font-bold text-primary-400">{plan.price}</span>
              <span class="text-sm text-secondary-400">{plan.period}</span>
            </div>

            <a
              href="https://app.deporgo.com"
              target="_blank"
              rel="noopener noreferrer"
              class={`mb-6 inline-flex w-full items-center justify-center rounded-lg px-4 py-3 text-center font-semibold transition-all duration-300 ${
                plan.highlighted
                  ? "bg-primary-500 text-white hover:bg-primary-600"
                  : "border border-primary-500 text-primary-400 hover:bg-primary-500/10"
              }`}
              aria-label={`${plan.cta} con el plan ${plan.name} en una nueva pestaña`}
            >
              {plan.cta}
            </a>

            <ul class="space-y-3" role="list">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-secondary-300">
                  <span class="mt-0.5 shrink-0 font-bold text-primary-400" aria-hidden="true">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="mb-4 text-secondary-400">
        ¿Buscas una implementación personalizada?
        <a href="#contacto-plataforma" class="font-semibold text-primary-400 hover:text-primary-300">
          Conversemos sobre tu caso
        </a>
      </p>
    </div>
  </div>
</section>
