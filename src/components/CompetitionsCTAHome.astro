---

---

<section
  id="cta-plataforma-home"
  class="border-y border-primary-500/20 py-16"
  aria-labelledby="cta-platform-title"
  style="background: linear-gradient(90deg, var(--primary-600-20) 0%, var(--secondary-600-20) 50%, var(--primary-600-20) 100%);"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="mb-4 inline-block rounded-full px-4 py-2 text-sm font-semibold text-primary-300" style="background-color: var(--primary-500-20);">
        🏆 NUEVA SOLUCIÓN
      </span>

      <h2 id="cta-platform-title" class="mb-4 text-3xl font-bold text-secondary-100 md:text-4xl">
        ¿Diriges ligas, torneos o campeonatos?
      </h2>

      <p class="mx-auto mb-8 max-w-2xl text-lg text-secondary-300">
        Centraliza calendarios, resultados y visibilidad pública con una plataforma
        creada para clubes y organizadores deportivos que quieren crecer con orden.
      </p>

      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/plataforma-competencias/"
          class="rounded-lg bg-primary-500 px-8 py-3 font-semibold text-white transition-colors hover:bg-primary-600"
          aria-label="Ir a la página de la Plataforma de Gestión para Ligas, Torneos y Campeonatos"
        >
          Conocer la Plataforma →
        </a>
        <a
          href="#comparativa"
          class="rounded-lg border border-primary-500 px-8 py-3 font-semibold text-primary-400 transition-colors hover:bg-primary-500/10"
          aria-label="Ir a la comparativa de soluciones"
        >
          Ver comparativa
        </a>
      </div>
    </div>
  </div>
</section>
