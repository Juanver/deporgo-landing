---
import { logoPath } from "@/data/logo";

const navLinks = [
  { href: "/automatizacion-deportiva/", label: "Automatización deportiva" },
  { href: "#demo", label: "Demo" },
  { href: "#clientes", label: "Clientes" },
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#clubs", label: "Para clubes" },
  { href: "#pichangas", label: "Para pichangas" },
  { href: "#faq", label: "FAQ" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-secondary-700/80 bg-secondary-950/90 backdrop-blur md:sticky"
>
  <div class="section-container flex h-16 items-center justify-between">
    <a
      href="/"
      class="inline-flex items-center gap-2"
      aria-label="Ir al inicio de Deporgo"
    >
      <!-- <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary-600 font-bold text-white">D</span> -->
      <img
        src={logoPath}
        alt="Deporgo Logo"
        width="36"
        height="36"
        fetchpriority="high"
        decoding="async"
        class="inline-flex h-9 w-9 items-center justify-center"
      />
      <span class="text-lg font-semibold text-secondary-200">Deporgo</span>
    </a>

    <nav
      aria-label="Navegación principal"
      class="hidden items-center gap-8 md:flex"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-secondary-300 transition hover:text-primary-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-secondary-950"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://app.deporgo.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Probar app de Deporgo en una nueva pestaña"
        class="btn-primary"
      >
        Probar App
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-lg border border-secondary-700 p-2 text-secondary-200 transition hover:border-primary-300/50 hover:text-primary-300 md:hidden"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-controls="mobile-drawer"
      aria-expanded="false"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-overlay"
    class="fixed inset-0 z-40 hidden bg-secondary-950/70 md:hidden"
    aria-hidden="true"
  >
  </div>

  <aside
    id="mobile-drawer"
    class="fixed inset-y-0 right-0 z-50 h-dvh w-80 max-w-[85vw] translate-x-full overflow-y-auto border-l border-secondary-700 bg-secondary-900 p-6 transition-transform duration-300 md:hidden"
    aria-label="Menú móvil"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
  >
    <div class="mb-8 flex items-center justify-between">
      <span class="text-lg font-semibold text-secondary-200">Menú</span>
      <button
        id="menu-close"
        class="rounded-lg border border-secondary-700 p-2 text-secondary-200 hover:border-primary-300/50 hover:text-primary-300"
        type="button"
        aria-label="Cerrar menú de navegación"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-5" aria-label="Navegación móvil">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-link text-base font-medium text-secondary-300 transition hover:text-primary-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-secondary-900"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://app.deporgo.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Probar app de Deporgo en una nueva pestaña"
        class="btn-primary mt-3"
      >
        Probar App
      </a>
    </nav>
  </aside>
</header>

<div class="h-16 md:hidden" aria-hidden="true"></div>

<script>
  const menuButton = document.getElementById("menu-toggle");
  const closeButton = document.getElementById("menu-close");
  const drawer = document.getElementById("mobile-drawer");
  const overlay = document.getElementById("mobile-overlay");
  const links = document.querySelectorAll(".mobile-link");
  let previousFocusedElement: Element | null = null;

  if (menuButton && closeButton && drawer && overlay) {
    const openMenu = () => {
      previousFocusedElement = document.activeElement;
      drawer.classList.remove("translate-x-full");
      overlay.classList.remove("hidden");
      menuButton.setAttribute("aria-expanded", "true");
      document.body.classList.add("overflow-hidden");
      closeButton.focus();
    };

    const closeMenu = () => {
      drawer.classList.add("translate-x-full");
      overlay.classList.add("hidden");
      menuButton.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden");
      if (previousFocusedElement instanceof HTMLElement) {
        previousFocusedElement.focus();
      }
    };

    menuButton.addEventListener("click", openMenu);
    closeButton.addEventListener("click", closeMenu);
    overlay.addEventListener("click", closeMenu);
    links.forEach((link) => link.addEventListener("click", closeMenu));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }
</script>
