---

---

<section 
  id="comparativa"
  class="py-20"
  aria-labelledby="comparison-title"
  data-reveal
  style="background-color: var(--secondary-800-50);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 id="comparison-title" class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-linear-to-r from-primary-400 to-secondary-400 mb-4">
        Comparativa de Soluciones
      </h2>
      <p class="text-lg text-secondary-300">
        Encuentra la herramienta perfecta para tu necesidad
      </p>
    </div>

    <div class="overflow-x-auto" role="region" aria-label="Tabla comparativa entre Deporgo y Plataforma de Competencias">
      <table class="w-full">
        <caption class="sr-only">
          Comparación de funcionalidades entre Deporgo y la Plataforma de Gestión para Ligas, Torneos y Campeonatos.
        </caption>
        <thead>
          <tr class="border-b border-secondary-700">
            <th scope="col" class="text-left py-4 px-4 font-semibold text-secondary-200">
              Característica
            </th>
            <th scope="col" class="text-center py-4 px-4 font-semibold text-secondary-200">
              <div class="text-sm font-bold text-primary-400 mb-1">🏃 DEPORGO</div>
              <div class="text-xs text-secondary-400">Para Clubes & Pichangas</div>
            </th>
            <th scope="col" class="text-center py-4 px-4 font-semibold text-secondary-200">
              <div class="text-sm font-bold text-secondary-300 mb-1">🏆 PLATAFORMA COMPETENCIAS</div>
              <div class="text-xs text-secondary-400">Para ligas, torneos y campeonatos</div>
            </th>
          </tr>
        </thead>
        <tbody class="text-secondary-300 text-sm">
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Gestión de aforos y cupos</td>
            <td class="text-center">✓</td>
            <td class="text-center">—</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Gestión de membresías</td>
            <td class="text-center">✓</td>
            <td class="text-center">—</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Cobros y seguimiento de pagos</td>
            <td class="text-center">✓</td>
            <td class="text-center">—</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Comunicaciones por WhatsApp</td>
            <td class="text-center">✓</td>
            <td class="text-center">—</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Gestión de ligas, torneos y campeonatos</td>
            <td class="text-center">—</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Tabla de posiciones automática</td>
            <td class="text-center">—</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Fixture y calendarios</td>
            <td class="text-center">—</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Página web pública personalizable</td>
            <td class="text-center">—</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Ranking de goleadores</td>
            <td class="text-center">—</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Multi-admin con permisos</td>
            <td class="text-center">✓</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Dashboard administrativo</td>
            <td class="text-center">✓</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="border-b border-secondary-700/50 hover:bg-secondary-700/30">
            <td class="py-4 px-4">Autenticación segura</td>
            <td class="text-center">✓</td>
            <td class="text-center">✓</td>
          </tr>
          <tr class="hover:bg-secondary-700/30">
            <td class="py-4 px-4 font-semibold">Casos de uso ideal</td>
            <td class="text-center">Clubes, pichangas, entrenamientos</td>
            <td class="text-center">Ligas locales, torneos y campeonatos</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-12 grid md:grid-cols-2 gap-8">
      <div class="rounded-xl p-8 border border-primary-500/20" style="background: linear-gradient(135deg, var(--primary-600-10) 0%, var(--primary-600-20) 100%);">
        <h3 class="text-xl font-bold text-secondary-100 mb-3">Elige DEPORGO si:</h3>
        <ul class="space-y-2 text-secondary-300 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Administras un club con membresías
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Necesitas gestionar cobros y asistencia
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Quieres automatizar convocatorias por WhatsApp
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Operas en modo local y necesitas operacional
          </li>
        </ul>
      </div>

      <div class="rounded-xl p-8 border border-secondary-500/20" style="background: linear-gradient(135deg, var(--secondary-600-10) 0%, var(--secondary-600-20) 100%);">
        <h3 class="text-xl font-bold text-secondary-100 mb-3">Elige Plataforma de Competencias si:</h3>
        <ul class="space-y-2 text-secondary-300 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Organizas ligas, torneos o campeonatos deportivos
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Quieres una web pública profesional
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Necesitas tabla de posiciones automática
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary-400 font-bold">✓</span>
            Deseas dar visibilidad online a tu competencia
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  table {
    @apply border-collapse;
  }
</style>
