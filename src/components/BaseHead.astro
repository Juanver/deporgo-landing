---
import { logoPath } from "@/data/logo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  keywords?: string[];
  type?: "website" | "article";
  noindex?: boolean;
  structuredData?:
    | Record<string, unknown>
    | Array<Record<string, unknown>>
    | string;
}

const {
  title = "Deporgo | Gestión deportiva por WhatsApp",
  description = "Automatiza asistencias, comunicación y pagos para clubes y pichangas con Deporgo integrado a WhatsApp.",
  canonical,
  image = logoPath,
  keywords = [],
  type = "website",
  noindex = false,
  structuredData,
} = Astro.props as Props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical
  ? new URL(canonical, site).toString()
  : new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image, site).toString();
const robots = noindex ? "noindex, nofollow" : "index, follow";
const schemaItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const schema = schemaItems
  .map((item) => (typeof item === "string" ? item : JSON.stringify(item)))
  .join("\n");
const keywordsContent = keywords.join(", ");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#020617" />
<link rel="icon" type="image/x-icon" href="/images/logo.ico" />
<link rel="preconnect" href="https://vrcclvbagevufvcyeipw.supabase.co" crossorigin />
<link rel="dns-prefetch" href="https://vrcclvbagevufvcyeipw.supabase.co" />
<link rel="preconnect" href="https://images.unsplash.com" crossorigin />
<link rel="dns-prefetch" href="https://images.unsplash.com" />
<title>{title}</title>
<meta name="description" content={description} />
{keywordsContent && <meta name="keywords" content={keywordsContent} />}
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<meta name="author" content="Deporgo" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Deporgo" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="es_PE" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:alt" content="Deporgo" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Deporgo" />

{schema && <script type="application/ld+json" is:inline set:html={schema} />}
