---
import type { iconFeatures } from "@/types/iconFeatures";
interface Props {
  title: string;
  description: string;
  points: string[];
  Icon?: iconFeatures;
}

const { title, description, points, Icon } = Astro.props as Props;
---

<article class="card-base h-full">
  <!-- <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary-950 text-lg text-primary-300">{icon}</div> -->
  <div class="flex items-start gap-2">
    {Icon && <Icon class="text-primary-300" aria-hidden="true" />}
    <h3 class="text-xl font-semibold text-secondary-200">{title}</h3>
  </div>
  <p class="mt-2 text-secondary-300">{description}</p>
  <ul class="mt-4 space-y-2">
    {
      points.map((point) => (
        <li class="flex items-start gap-2 text-sm text-secondary-300">
          <span
            class="mt-1 h-2 w-2 rounded-full bg-primary-400"
            aria-hidden="true"
          />
          <span>{point}</span>
        </li>
      ))
    }
  </ul>
</article>
