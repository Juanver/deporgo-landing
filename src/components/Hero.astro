<section
  class="relative isolate overflow-hidden border-b border-secondary-700"
  aria-labelledby="hero-title"
>
  <img
    src="https://images.unsplash.com/photo-1632300951015-42d7df909581?q=80&w=1400&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
    alt="Equipo deportivo entrenando en cancha"
    width="1400"
    height="900"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-secondary-950/72 via-secondary-950/88 to-secondary-950"
    aria-hidden="true"
  >
  </div>

  <div class="section-container relative py-20 sm:py-24 lg:py-28">
    <div
      class="automation-signal flex flex-wrap items-center gap-x-3 gap-y-2 sm:inline-flex sm:flex-nowrap"
      data-reveal
      aria-label="Automatización deportiva por WhatsApp"
    >
      <span class="flex flex-wrap items-center gap-2 sm:flex-nowrap sm:gap-3">
        <span
          class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary-300"
        >
          Automatización deportiva
        </span>

        <span
          class="relative hidden h-px w-8 overflow-hidden bg-primary-300/25 sm:block sm:w-10"
          aria-hidden="true"
        >
          <span
            class="absolute inset-y-0 left-0 w-5 bg-primary-300/80 motion-safe:animate-[signal_2s_ease-in-out_infinite]"
          ></span>
        </span>

        <span
          class="relative text-[11px] font-semibold uppercase tracking-[0.14em]"
        >
          <span class="text-white/45">por WhatsApp</span>

          <span
            class="text-shine-mask absolute inset-0 text-primary-100 motion-safe:animate-[signal_2s_ease-in-out_infinite]"
            aria-hidden="true"
          >
            por WhatsApp
          </span>
        </span>
      </span>
    </div>

    <!-- <p
      class="max-w-sm text-sm uppercase tracking-[0.2em] text-secondary-300"
      data-reveal
    >
      Menos gestión manual. Más deporte.
    </p> -->

    <h1
      id="hero-title"
      class="mt-4 max-w-3xl text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl"
      data-reveal
    >
      Una solución para <span class="text-primary-400">Clubes</span> y
      <span class="text-primary-400"> Pichangas</span>.
    </h1>

    <p class="mt-5 max-w-2xl text-lg text-secondary-300" data-reveal>
      Centraliza cupos, asistencias y pagos en un solo flujo profesional con
      mensajes automáticos y confirmaciones en tiempo real vía WhatsApp.
    </p>

    <div class="mt-10" data-reveal>
      <a
        href="https://app.deporgo.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline border-primary-300/80 bg-primary-950/25 text-primary-300 hover:bg-primary-950/40"
        aria-label="Probar app de Deporgo en una nueva pestaña"
      >
        Probar app
      </a>
    </div>
  </div>
</section>
