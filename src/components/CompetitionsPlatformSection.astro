---
import { platformFeatures } from "@/data/competitions-platform-data";
import CompetitionsFeatureCard from "@/components/CompetitionsFeatureCard.astro";

interface Props {
  limit?: number;
  showIncludes?: boolean;
  showCta?: boolean;
}

const { limit, showIncludes = true, showCta = false } = Astro.props as Props;
const features = typeof limit === "number" ? platformFeatures.slice(0, limit) : platformFeatures;
---

<section
  id="plataforma-competencias"
  class="py-20"
  aria-labelledby="platform-title"
  data-reveal
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 id="platform-title" class="bg-linear-to-r from-primary-400 to-secondary-400 bg-clip-text text-4xl font-bold text-transparent md:text-5xl" data-reveal>
        Plataforma de Gestión para Ligas, Torneos y Campeonatos
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-secondary-300" data-reveal>
        Profesionaliza tus competencias con una plataforma que automatiza resultados,
        ordena la operación de clubes y ligas, y publica una experiencia digital de primer nivel.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {features.map((feature, index) => (
        <CompetitionsFeatureCard feature={feature} index={index} />
      ))}
    </div>

    {showCta && (
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row" data-reveal>
        <a
          href="/plataforma-competencias/"
          class="rounded-lg bg-primary-500 px-8 py-3 font-semibold text-white transition-colors hover:bg-primary-600"
          aria-label="Ver la plataforma completa para ligas, torneos y campeonatos"
        >
          Ver plataforma completa
        </a>
        <a
          href="/competencias/liga-san-isidro"
          class="rounded-lg border border-primary-500 px-8 py-3 font-semibold text-primary-400 transition-colors hover:bg-primary-500/10"
          aria-label="Ver demo real de tabla, fixture y goleadores"
        >
          Ver demo en vivo
        </a>
      </div>
    )}

    {showIncludes && (
    <div class="mt-16 rounded-2xl border border-primary-500/20 p-8" style="background: linear-gradient(135deg, var(--primary-600-10) 0%, var(--secondary-600-20) 100%);">
      <h3 class="mb-4 text-2xl font-bold text-secondary-100">Todo lo que incluye la plataforma:</h3>
      <ul class="grid gap-4 md:grid-cols-2" role="list">
        <li class="flex items-center gap-3 text-secondary-300">
          <span class="font-bold text-primary-400" aria-hidden="true">✓</span>
          Panel administrativo intuitivo
        </li>
        <li class="flex items-center gap-3 text-secondary-300">
          <span class="font-bold text-primary-400" aria-hidden="true">✓</span>
          Página pública de competencia personalizable
        </li>
        <li class="flex items-center gap-3 text-secondary-300">
          <span class="font-bold text-primary-400" aria-hidden="true">✓</span>
          Gestión segura de usuarios y permisos
        </li>
        <li class="flex items-center gap-3 text-secondary-300">
          <span class="font-bold text-primary-400" aria-hidden="true">✓</span>
          API para integraciones
        </li>
        <li class="flex items-center gap-3 text-secondary-300">
          <span class="font-bold text-primary-400" aria-hidden="true">✓</span>
          Almacenamiento de imágenes en la nube
        </li>
        <li class="flex items-center gap-3 text-secondary-300">
          <span class="font-bold text-primary-400" aria-hidden="true">✓</span>
          Soporte técnico especializado
        </li>
      </ul>
    </div>
    )}
  </div>
</section>
