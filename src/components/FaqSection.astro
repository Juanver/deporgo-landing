---
import { faqItems } from "@/data/seo";
---

<section id="faq" class="border-t border-secondary-700 py-20" aria-labelledby="faq-title" data-reveal>
  <div class="section-container">
    <h2 id="faq-title" class="section-title" data-reveal>Preguntas frecuentes</h2>
    <p class="section-subtitle" data-reveal>
      Resolvemos dudas clave sobre automatización deportiva para clubes, academias y pichangas.
    </p>

    <div class="mt-10 grid gap-4" data-reveal>
      {faqItems.map((item) => (
        <details class="card-base group">
          <summary class="cursor-pointer list-none text-left text-base font-semibold text-secondary-200 marker:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-secondary-950">
            <span class="inline-flex items-start justify-between gap-4">
              <span>{item.question}</span>
              <span aria-hidden="true" class="text-primary-300 transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-secondary-300">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
