---
const clients = [
  { name: "Little Panda FC", initials: "LP", img: "https://vrcclvbagevufvcyeipw.supabase.co/storage/v1/object/sign/deporgo/logos/little-panda.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9iMDZiOTkzZS1hNGMwLTQwMmEtODliMS1iZWE2NzcwMTc2ZWYiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJkZXBvcmdvL2xvZ29zL2xpdHRsZS1wYW5kYS5wbmciLCJzY29wZSI6ImRvd25sb2FkIiwiaWF0IjoxNzg3MDI1NTY2LCJleHAiOjE4MTg1NjE1NjZ9.GEYBxQ26GgdF_iWk0aWxoVCiiWT7PuBSb3qCt4Tg0ho" },
  { name: "Pancho Pichangas", initials: "PP", img: "" }
];

const carouselItems = [...clients, ...clients];
---

<section class="border-y border-secondary-700 py-14" aria-labelledby="clients-title" data-reveal>
  <div class="section-container">
    <h2 id="clients-title" class="section-title text-center" data-reveal>Confian en nosotros</h2>

    <div class="clients-carousel mt-8" aria-label="Carrusel de clientes" data-reveal>
      <ul class="clients-track" role="list">
        {carouselItems.map((client, index) => (
          <li class="clients-item card-base" aria-label={client.name} aria-hidden={index >= clients.length ? "true" : "false"}>
            {
              client.img
                ? <img src={client.img} alt={client.name} class="h-20 rounded-full object-cover" />
                : <span class="inline-flex h-20 w-20 items-center justify-center rounded-full bg-primary-950 text-lg font-semibold text-primary-300">{client.initials}</span>
            }
            <p class="mt-4 text-sm font-semibold text-secondary-200">{client.name}</p>
            <p class="mt-1 text-sm text-secondary-400">Cliente activo</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
