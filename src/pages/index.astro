---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import OurClients from "../components/OurClients.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Footer from "../components/Footer.astro";

const clubFeatures = [
  {
    icon: "🏟️",
    title: "Membresías y planes",
    description: "Controla socios activos, vencimientos y renovaciones desde un solo panel.",
    points: [
      "Estados de membresía en tiempo real",
      "Recordatorios automáticos por WhatsApp",
      "Segmentación por categoría o sede"
    ]
  },
  {
    icon: "📋",
    title: "Asistencia y aforos",
    description: "Gestiona cupos por entrenamiento o clase evitando sobrecarga operativa.",
    points: [
      "Registro rápido de asistencia",
      "Límites por sesión y lista de espera",
      "Alertas automáticas a ausentes"
    ]
  },
  {
    icon: "💳",
    title: "Cobros simplificados",
    description: "Reduce morosidad con flujos de pago claros y confirmación automática.",
    points: [
      "Seguimiento de pagos pendientes",
      "Notificaciones previas al vencimiento",
      "Historial centralizado por cliente"
    ]
  }
];

const pichangaFeatures = [
  {
    icon: "⚽",
    title: "Listas en segundos",
    description: "Publica partido, abre cupos y confirma jugadores en tiempo récord.",
    points: [
      "Convocatorias instantáneas",
      "Confirmación por orden de llegada",
      "Control de suplentes y reemplazos"
    ]
  },
  {
    icon: "💬",
    title: "Cierre automático por WhatsApp",
    description: "Cuando se llenan los cupos, Deporgo cierra la lista y avisa a todos automáticamente.",
    points: [
      "Mensajes de cierre sin intervención manual",
      "Avisos de última hora para suplentes",
      "Menos spam y más claridad"
    ]
  },
  {
    icon: "💸",
    title: "Pagos ordenados",
    description: "Controla quién pagó, quién falta y evita discusiones antes del partido.",
    points: [
      "Estado de pago por jugador",
      "Recordatorios antes del evento",
      "Resumen rápido para el organizador"
    ]
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Deporgo",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Tecnología de gestión deportiva integrado con WhatsApp para clubes, academias y pichangas.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  }
};
---

<Layout
  title="Deporgo | Tecnología de gestión deportiva con WhatsApp"
  description="Aumenta ocupación, reduce ausencias y organiza pagos con flujos automáticos por WhatsApp para clubes y pichangas."
  canonical="https://deporgo.com/"
  structuredData={jsonLd}
>
  <header>
    <Header />
  </header>

  <main>
    <Hero />
    <OurClients />

    <section id="como-funciona" class="py-20" aria-labelledby="how-title" data-reveal>
      <div class="section-container">
        <h2 id="how-title" class="section-title" data-reveal>Cómo funciona</h2>
        <p class="section-subtitle" data-reveal>Una operación clara en tres pasos para mover tu gestión deportiva de lo manual a lo automático.</p>

        <ol class="mt-10 grid gap-6 md:grid-cols-3">
          <li class="card-base" data-reveal>
            <span class="text-sm font-semibold text-primary-400">Paso 1</span>
            <h3 class="mt-2 text-xl font-semibold text-secondary-200">Configura tu actividad</h3>
            <p class="mt-2 text-secondary-300">Define horarios, cupos, reglas y valores de inscripción según tu tipo de operación.</p>
          </li>
          <li class="card-base" data-reveal>
            <span class="text-sm font-semibold text-primary-400">Paso 2</span>
            <h3 class="mt-2 text-xl font-semibold text-secondary-200">Invita por WhatsApp</h3>
            <p class="mt-2 text-secondary-300">Comparte tu convocatoria y deja que Deporgo gestione confirmaciones y respuestas.</p>
          </li>
          <li class="card-base" data-reveal>
            <span class="text-sm font-semibold text-primary-400">Paso 3</span>
            <h3 class="mt-2 text-xl font-semibold text-secondary-200">Automatiza cierres y seguimiento</h3>
            <p class="mt-2 text-secondary-300">Cuando se completa el aforo, Deporgo cierra listas y mantiene al grupo informado automáticamente.</p>
          </li>
        </ol>
      </div>
    </section>

    <section id="clubs" class="border-y border-secondary-700 py-20" aria-labelledby="clubs-title" data-reveal>
      <div class="section-container">
        <h2 id="clubs-title" class="section-title" data-reveal>Soluciones para Clubes y Academias</h2>
        <p class="section-subtitle" data-reveal>Escala tu operación profesional con control de membresías, asistencia y límites por sesión.</p>

        <div class="mt-10 grid gap-6 lg:grid-cols-3" data-reveal>
          {clubFeatures.map((feature) => (
            <FeatureCard {...feature} />
          ))}
        </div>

        <div class="mt-10" data-reveal>
          <a href="https://app.deporgo.com" target="_blank" rel="noreferrer" class="btn-primary" aria-label="Probar Deporgo para clubes">
            Probar App para Clubes
          </a>
        </div>
      </div>
    </section>

    <section id="pichangas" class="py-20" aria-labelledby="pichangas-title" data-reveal>
      <div class="section-container">
        <h2 id="pichangas-title" class="section-title" data-reveal>Soluciones para Pichangas</h2>
        <p class="section-subtitle" data-reveal>Gestiona partidos casuales con listas rápidas, pagos ordenados y cierre automático por WhatsApp.</p>

        <div class="mt-10 grid gap-6 lg:grid-cols-3" data-reveal>
          {pichangaFeatures.map((feature) => (
            <FeatureCard {...feature} />
          ))}
        </div>

        <div class="mt-10" data-reveal>
          <a href="https://app.deporgo.com" target="_blank" rel="noreferrer" class="btn-primary" aria-label="Probar Deporgo para pichangas">
            Probar App para Pichangas
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
