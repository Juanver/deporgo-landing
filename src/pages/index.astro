    <section
      id="clubs"
      class="border-y border-secondary-700 py-20"
      aria-labelledby="clubs-title"
      data-reveal
    >
      <div class="section-container">
        <h2 id="clubs-title" class="section-title" data-reveal>
          Soluciones para Clubes y Academias
        </h2>
        <p class="section-subtitle" data-reveal>
          Escala tu operación profesional con control de membresías, asistencia
          y límites por sesión.
        </p>

        <div class="mt-10 grid gap-6 lg:grid-cols-3" data-reveal>
          {clubFeatures.map((feature) => <FeatureCard {...feature} />)}
        </div>

        <div class="mt-10" data-reveal>
          <a
            href="https://app.deporgo.com"
            target="_blank"
            rel="noreferrer"
            class="btn-primary"
            aria-label="Probar Deporgo para clubes"
          >
            Probar App para Clubes
          </a>
        </div>
      </div>
    </section>

    <section
      id="pichangas"
      class="py-20"
      aria-labelledby="pichangas-title"
      data-reveal
    >
      <div class="section-container">
        <h2 id="pichangas-title" class="section-title" data-reveal>
          Soluciones para Pichangas
        </h2>
        <p class="section-subtitle" data-reveal>
          Gestiona partidos casuales con listas rápidas, pagos ordenados y
          cierre automático por WhatsApp.
        </p>

        <div class="mt-10 grid gap-6 lg:grid-cols-3" data-reveal>
          {pichangaFeatures.map((feature) => <FeatureCard {...feature} />)}
        </div>

        <div class="mt-10" data-reveal>
          <a
            href="https://app.deporgo.com"
            target="_blank"
            rel="noreferrer"
            class="btn-primary"
            aria-label="Probar Deporgo para pichangas"
          >
            Probar App para Pichangas
          </a>
        </div>
      </div>
    </section>

    <section
      id="contacto"
      class="border-t border-secondary-700 py-20"
      aria-labelledby="contact-title"
      data-reveal
    >
      <div class="section-container">
        <h2 id="contact-title" class="section-title" data-reveal>Contacto</h2>
        <p class="section-subtitle" data-reveal>
          Escríbenos por WhatsApp y te ayudamos a implementar Deporgo en tu
          operación deportiva.
        </p>

        <div class="mt-10" data-reveal>
          <a
            href="https://wa.me/51979765191"
            target="_blank"
            rel="noreferrer"
            class="btn-primary"
            aria-label="Contactar por WhatsApp al +51 979765191"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
