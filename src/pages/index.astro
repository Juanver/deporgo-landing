---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import OurClients from "../components/OurClients.astro";
import Footer from "../components/Footer.astro";
import CompetitionsPlatformSection from "@/components/CompetitionsPlatformSection.astro";
import CompetitionsCTAHome from "@/components/CompetitionsCTAHome.astro";
import FaqSection from "@/components/FaqSection.astro";
import { homeSeo, homeStructuredData } from "@/data/seo";
---

<Layout
  title={homeSeo.title}
  description={homeSeo.description}
  canonical={homeSeo.canonical}
  keywords={homeSeo.keywords}
  structuredData={homeStructuredData}
>
  <Header />

  <main id="main-content">
    <Hero />

    <CompetitionsPlatformSection limit={4} showIncludes={false} showCta={true} />

    <CompetitionsCTAHome />

    <OurClients />

    <section
      id="otras-soluciones"
      class="border-y border-secondary-700 py-20"
      aria-labelledby="other-solutions-title"
      data-reveal
    >
      <div class="section-container">
        <h2 id="other-solutions-title" class="section-title" data-reveal>
          ¿Gestionas un club o pichangas?
        </h2>
        <p class="section-subtitle" data-reveal>
          Además de competencias, Deporgo automatiza asistencia, cupos y pagos
          por WhatsApp para clubes, academias y partidos casuales.
        </p>

        <div class="mt-10 flex flex-wrap gap-3" data-reveal>
          <a
            href="/automatizacion-deportiva/"
            class="btn-primary"
            aria-label="Ver soluciones de automatización para clubes y pichangas"
          >
            Ver soluciones para clubes y pichangas
          </a>
          <a
            href="https://app.deporgo.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
            aria-label="Probar la app de Deporgo en una nueva pestaña"
          >
            Probar app
          </a>
        </div>
      </div>
    </section>

    <FaqSection />

    <section
      id="contacto"
      class="py-20"
      aria-labelledby="contact-title"
      data-reveal
    >
      <div class="section-container">
        <h2 id="contact-title" class="section-title" data-reveal>Contacto</h2>
        <p class="section-subtitle" data-reveal>
          Escríbenos por WhatsApp y te ayudamos a implementar Deporgo en tu
          liga, torneo, campeonato o club.
        </p>

        <div class="mt-10" data-reveal>
          <a
            href="https://wa.me/51928936489"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
            aria-label="Contactar por WhatsApp"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
